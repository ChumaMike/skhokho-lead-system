# Copy to .env.local and fill in. .env.local is gitignored.

# ── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Used only by scripts/migrate*.js (one-shot DB migrations)
SUPABASE_ACCESS_TOKEN=sbp_...

# ── Anthropic (Claude — message generation) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Places (lead discovery) ──────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ── WhatsApp (Meta Cloud API + webhook) ─────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ── Twilio (legacy WhatsApp webhook signature verification) ─────────────
TWILIO_AUTH_TOKEN=

# ── Cron (activation-cron route auth) ───────────────────────────────────
CRON_SECRET=<long-random-string>

# ── Resend (email outreach) ─────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
EMAIL_FROM_ADDRESS=chuma@skhokholabs.xyz
EMAIL_REPLY_TO=chuma@skhokholabs.xyz
# POPIA s.69 requires every cold email to include a physical postal address
EMAIL_PHYSICAL_ADDRESS=
# Used to sign one-click unsubscribe links — generate with: openssl rand -hex 32
UNSUBSCRIBE_HMAC_SECRET=
